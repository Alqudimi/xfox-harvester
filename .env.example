# ============================================================
# XFox Harvester — Environment configuration
# Copy this file to `.env` and adjust the values.
# ============================================================

# --- Server ---
XFOX_HOST=0.0.0.0
XFOX_PORT=8000

# --- Storage root (account workspaces, exports, run logs) ---
XFOX_DATA_DIR=./data

# --- PostgreSQL connection (SQLAlchemy async URL) ---
# Local example:  postgresql+asyncpg://xfox:xfox_password@localhost:5432/xfox
# Docker example: postgresql+asyncpg://xfox:xfox_password@postgres:5432/xfox
XFOX_DATABASE_URL=postgresql+asyncpg://xfox:xfox_password@localhost:5432/xfox

# --- Security ---
# Generate a strong secret:  python -c "import secrets; print(secrets.token_urlsafe(48))"
XFOX_SECRET_KEY=CHANGE_ME_GENERATE_A_LONG_RANDOM_STRING
XFOX_COOKIE_SECURE=false        # set to true when serving behind HTTPS
XFOX_SESSION_DAYS=7             # web login session lifetime in days

# --- Logging ---
XFOX_LOG_LEVEL=INFO             # DEBUG | INFO | WARNING | ERROR

# --- X-CrawlFox engine ---
XFOX_CRAWLFOX_BIN=x-crawlfox    # executable name or absolute path
XFOX_CAMOUFOX_FETCH=camoufox fetch   # command that downloads the Camoufox browser

# --- Misc ---
XFOX_ENVIRONMENT=production     # production | development
